{
	"name": "@herbivore/core",
	"version": "4.0.0",
	"description": "Herbivore Project Package - Core",
	"author": "Herbivore",
	"license": "MIT",
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"exports": {
		"./models/*": {
			"types": "./lib/models/index.d.ts",
			"default": "./lib/models/*.js"
		},
		"./utils/*": {
			"types": "./lib/utils/index.d.ts",
			"default": "./lib/utils/*.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"src"
	],
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf lib",
		"rebuild": "npm run clean && npm run build",
		"build:test": "tsc -p ./tsconfig.spec.json",
		"test": "jest --config=./spec/jest.config.ts",
		"prepublishOnly": "npm run clean && npm run build",
		"publish:prod": "npm publish --access public",
		"publish:dry": "npm publish --access public --dry-run",
		"upgrade": "npm update --save && npm update --save-dev"
	},
	"dependencies": {
		"js-base64": "^3.7.7",
		"mongodb": "^6.16.0",
		"os": "^0.1.2",
		"ts-md5": "^1.3.1",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@skypack/package-check": "^0.2.2",
		"@types/jest": "^29.5.14",
		"@types/lodash": "^4.17.16",
		"@types/node": "^18.19.86",
		"jest": "^29.7.0",
		"lodash": "^4.17.21",
		"ts-jest": "^29.3.2",
		"ts-node": "^10.9.2",
		"typescript": "5.8.3"
	},
	"keywords": [
		"core",
		"herbivore"
	],
	"repository": {
		"url": "https://github.com/MultiDrew97/herbivore",
		"directory": "core",
		"type": "git"
	},
	"directories": {
		"lib": "./lib"
	}
}
