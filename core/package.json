{
	"name": "@herbivore/core",
	"version": "4.2.0",
	"author": "Herbivore",
	"description": "Herbivore Project Package - Core",
	"license": "MIT",
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf lib",
		"rebuild": "npm run clean && npm run build",
		"test": "vitest",
		"prepublishOnly": "npm test -- run && npm run rebuild",
		"publish:prod": "npm publish --access public",
		"publish:dry": "npm publish --access public --dry-run",
		"update": "npm update --save && npm update --save-dev"
	},
	"exports": {
		"./models": {
			"types": "./lib/models/index.d.ts",
			"default": "./lib/models/index.js"
		},
		"./models/*": {
			"types": "./lib/models/*.d.ts",
			"default": "./lib/models/*.js"
		},
		"./utils": {
			"types": "./lib/utils/index.d.ts",
			"default": "./lib/utils/index.js"
		},
		"./utils/*": {
			"types": "./lib/utils/*.d.ts",
			"default": "./lib/utils/*.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"./lib",
		"./src"
	],
	"dependencies": {
		"js-base64": "^3.7.8",
		"mongodb": "^6.21.0",
		"os": "^0.1.2",
		"ts-md5": "^1.3.1",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@skypack/package-check": "^0.2.2",
		"@types/lodash": "^4.17.23",
		"lodash": "^4.17.23",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	},
	"keywords": [
		"core",
		"herbivore"
	],
	"repository": {
		"url": "https://github.com/MultiDrew97/herbivore",
		"directory": "core",
		"type": "git"
	},
	"directories": {
		"lib": "./lib",
		"test": "./spec"
	}
}
