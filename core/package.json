{
	"name": "@herbivore/core",
	"version": "4.0.0",
	"author": "Herbivore",
	"description": "Herbivore Project Package - Core",
	"license": "MIT",
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf lib",
		"rebuild": "npm run clean && npm run build",
		"test": "jest --config=./jest.config.ts",
		"prepublishOnly": "npm run rebuild",
		"publish:prod": "npm publish --access public",
		"publish:dry": "npm publish --access public --dry-run",
		"upgrade": "npm update --save && npm update --save-dev"
	},
	"exports": {
		"./models/*": {
			"types": "./lib/models/index.d.ts",
			"require": "./lib/models/*.js",
			"default": "./src/models/*.ts"
		},
		"./utils/*": {
			"types": "./lib/utils/index.d.ts",
			"require": "./lib/utils/*.js",
			"default": "./src/utils/*.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"./lib",
		"./src"
	],
	"dependencies": {
		"js-base64": "^3.7.8",
		"mongodb": "^6.20.0",
		"os": "^0.1.2",
		"ts-md5": "^1.3.1",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@skypack/package-check": "^0.2.2",
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.20",
		"jest": "^30.2.0",
		"lodash": "^4.17.21",
		"ts-jest": "^29.4.5",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	},
	"keywords": [
		"core",
		"herbivore"
	],
	"repository": {
		"url": "https://github.com/MultiDrew97/herbivore",
		"directory": "core",
		"type": "git"
	},
	"directories": {
		"lib": "./lib"
	}
}
