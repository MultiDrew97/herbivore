{
	"name": "@herbivore/core",
	"version": "3.0.0",
	"description": "Herbivore Password Manager - Core",
	"author": "Herbivore",
	"license": "MIT",
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc",
		"build:test": "tsc -p ./tsconfig.spec.json",
		"test": "jest --config=./jest.config.ts",
		"publish:prod": "cp package.json ./dist && cd dist && npm publish --access public",
		"publish:dry": "cp package.json ./dist && cd dist && npm publish --access public --dry-run",
		"upgrade": "npm update --save"
	},
	"engines": {
		"node": "^14.15.0 || >=16.10.0"
	},
	"dependencies": {
		"js-base64": "^3.7.7",
		"mongodb": "^6.12.0",
		"os": "^0.1.2",
		"ts-md5": "^1.3.1",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@skypack/package-check": "^0.2.2",
		"@types/jest": "^29.5.14",
		"@types/node": "^18.19.68",
		"@types/lodash": "^4.17.13",
		"lodash": "^4.17.21",
		"jest": "^29.7.0",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"typescript": "^4.9.5"
	},
	"keywords": [
		"core",
		"hpm",
		"password",
		"password manager"
	],
	"repository": {
		"url": "https://github.com/MultiDrew97/hpm-modules",
		"directory": "core",
		"type": "git"
	},
	"directories": {
		"test": "./spec",
		"lib": "./dist"
	}
}
