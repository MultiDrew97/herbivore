{
	"extends": "../tsconfig.base.spec.json",
	"include": ["spec", "./vitest.*"],
	"files": ["../matchers.d.ts"],
	"exclude": ["node_modules", "lib"],
	"references": [{ "path": "../tsconfig.base.spec.json" }, { "path": "./tsconfig.json" }],
	"compilerOptions": {
		"outDir": "./lib/spec",
		"rootDir": ".",
		"paths": {
			"@base/*": ["../vitest.*.ts"],
			"@spec/*": ["./vitest.*.ts"],

			"@utils": ["./src/utils/index"],
			"@utils/*": ["./src/utils/*"],
			"@models": ["./src/models/index"],
			"@models/*": ["./src/models/*"]
		}
	}
}
