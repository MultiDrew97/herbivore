{
	"extends": "../tsconfig.base.json",
	"include": ["src"],
	"exclude": ["node_modules", "lib", "spec"],
	"compilerOptions": {
		"outDir": "./lib",
		"rootDir": "./src",
		"baseUrl": "./src",
		"tsBuildInfoFile": "./lib/tsconfig.tsbuildinfo",
		"paths": {
			"@utils": ["./utils/index"],
			"@utils/*": ["./utils/*"],
			"@models": ["./models/index"],
			"@models/*": ["./models/*"]
		}
	}
}
