{
	"extends": "../tsconfig.base.json",
	"include": ["src"],
	"exclude": ["node_modules", "lib", "spec"],
	"compilerOptions": {
		"outDir": "./lib",
		"rootDir": "./src",
		"tsBuildInfoFile": "core.tsbuildinfo",
		"paths": {
			"@utils": ["./src/utils/index"],
			"@utils/*": ["./src/utils/*"],
			"@models": ["./src/models/index"],
			"@models/*": ["./src/models/*"]
		}
	}
}
