{
	"extends": "../tsconfig.base.spec.json",
	"include": ["spec", "package.json", "vitest.*"],
	"exclude": ["node_modules", "lib"],
	"references": [{ "path": "../tsconfig.base.spec.json" }, { "path": "./tsconfig.json" }],
	"compilerOptions": {
		"jsx": "react-native",
		"outDir": "./lib/spec",
		"rootDir": ".",
		"types": ["jest", "node"],
		"noEmit": true,
		"paths": {
			"@base/*": ["../vitest.*"],
			"@spec/*": ["./vitest.*"],
			"@src/*": ["./src/*"]
		}
	}
}
