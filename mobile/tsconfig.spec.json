{
	"extends": "../tsconfig.base.spec.json",
	"include": ["spec", "./vitest.*"],
	"exclude": ["node_modules", "lib"],
	"references": [{ "path": "../tsconfig.base.spec.json" }, { "path": "./tsconfig.json" }],
	"compilerOptions": {
		"outDir": "./lib/spec",
		"rootDir": ".",
		"paths": {
			"@base/*": ["../vitest.*.ts"],
			"@spec/*": ["./vitest.*.ts"],
			"@src": ["./src/index.tsx"],
			"@src/*": ["./src/*.tsx"]
		}
	}
}
