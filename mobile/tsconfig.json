{
	"extends": "expo/tsconfig.base",
	"include": ["src"],
	"exclude": ["node_modules", "lib", "spec"],
	"compilerOptions": {
		"jsx": "react-native",
		"moduleResolution": "bundler",
		"customConditions": ["react-native"],
		"lib": ["DOM", "ESNext"],
		"target": "esnext",
		"noEmit": false,
		"composite": true,
		"outDir": "./lib",
		"rootDir": "./src",
		"tsBuildInfoFile": "mobile.tsbuildinfo",
		"paths": {
			"@src": ["./src/index"],
			"@src/*": ["./src/*"],
			"@herbivore/eslint-plugin": ["../eslint.config.mjs"]
		}
	}
}
