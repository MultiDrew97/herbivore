{
	"name": "@herbivore/mobile",
	"version": "0.1.0",
	"description": "Herbivore Project Package - Mobile",
	"license": "MIT",
	"author": "Herbivore",
	"scripts": {
		"lint": "expo lint",
		"build": "tsc && tsc-alias",
		"clean": "rm -rf lib mobile.tsbuildinfo",
		"rebuild": "npm run clean && npm run build",
		"test:bak": "jest -c spec/jest.config.ts",
		"test": "vitest",
		"prepack": "npm run rebuild",
		"prepublishOnly": "npm test -- run && npm run rebuild",
		"publish:prod": "npm publish --access public",
		"publish:dry": "npm publish --access public --dry-run",
		"update": "npm install expo@latest --save-peer && expo install --fix"
	},
	"exports": {
		"./ui/*": {
			"types": "./lib/ui/*.d.ts",
			"default": "./lib/ui/*.js"
		},
		"./hooks/*": {
			"types": "./lib/hooks/*.d.ts",
			"default": "./lib/hooks/*.js"
		},
		"./*": {
			"types": "./lib/*.d.ts",
			"default": "./lib/*.js"
		},
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"peerDependencies": {
		"expo": "^58.0.0",
		"expo-constants": "^58.0.0",
		"react": "^19.3.0",
		"react-native": ">=0.88.0"
	},
	"dependencies": {
		"expo-haptics": "^58.0.0",
		"expo-router": "~58.0.25",
		"expo-symbols": "^58.0.0",
		"react-native-mmkv": "^4.0.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@react-native/babel-preset": "^0.86.0",
		"@react-native/jest-preset": "^0.88.0",
		"@testing-library/react-native": "^14.0.0",
		"@types/jest": "30.0.0",
		"@types/lodash": "4.17.24",
		"@types/react": "~19.3.0",
		"eslint-plugin-react": "^7.0.0",
		"eslint-plugin-react-hooks": "^7.0.0",
		"eslint-plugin-react-native": "^5.0.0",
		"expo-linking": "^58.0.0",
		"expo-local-authentication": "^58.0.0",
		"jest": "^30.0.0",
		"jest-expo": "^58.0.0",
		"lodash": "4.18.1",
		"test-renderer": "^1.2.0",
		"tslib": "2.8.1",
		"vitest-native": "^0.13.0"
	},
	"files": [
		"./src",
		"./lib",
		"./spec"
	],
	"keywords": [
		"herbivore",
		"mobile",
		"expo",
		"react-native",
		"rn",
		"ts"
	],
	"homepage": "https://github.com/MultiDrew97/herbivore#readme",
	"bugs": {
		"url": "https://github.com/MultiDrew97/herbivore/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MultiDrew97/herbivore.git",
		"directory": "mobile"
	}
}
