{
	"name": "@herbivore/mobile",
	"version": "0.1.0",
	"description": "Herbivore Project Package - Mobile",
	"license": "MIT",
	"author": "Herbivore",
	"scripts": {
		"build": "tsc && tsc-alias",
		"clean": "rm -rf lib tsconfig.tsbuildinfo",
		"rebuild": "npm run clean && npm run build",
		"test:bak": "jest -c spec/jest.config.ts",
		"test": "vitest",
		"prepublishOnly": "npm test -- run && npm run rebuild",
		"publish:prod": "npm publish --access public",
		"publish:dry": "npm publish --access public --dry-run",
		"update": "npm install expo@latest --save-peer && expo install --fix"
	},
	"exports": {
		"./ui/*": {
			"types": "./lib/ui/*.d.ts",
			"default": "./lib/ui/*.js"
		},
		"./hooks/*": {
			"types": "./lib/hooks/*.d.ts",
			"default": "./lib/hooks/*.js"
		},
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"expo": "^57.0.0",
		"react": "19.2.3",
		"react-native": "^0.86.0"
	},
	"dependencies": {
		"expo-constants": "57.x",
		"expo-haptics": "57.x",
		"expo-linking": "57.x",
		"expo-local-authentication": "57.x",
		"expo-router": "57.x",
		"expo-symbols": "57.x",
		"react-native-mmkv": "4.x",
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@react-native/babel-preset": "^0.86.3",
		"@react-native/jest-preset": "^0.86.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react-native": "14.x",
		"@types/jest": "29.5.14",
		"@types/lodash": "4.17.24",
		"@types/react": "^19.2.14",
		"jest": "~29.7.0",
		"jest-expo": "~57.0.5",
		"lodash": "4.18.1",
		"test-renderer": "^1.2.0",
		"typescript": "~6.0.3",
		"vitest-native": "^0.13.0"
	},
	"files": [
		"./src"
	],
	"keywords": [
		"herbivore",
		"mobile",
		"expo",
		"react-native",
		"rn",
		"ts"
	],
	"homepage": "https://github.com/MultiDrew97/herbivore#readme",
	"bugs": {
		"url": "https://github.com/MultiDrew97/herbivore/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MultiDrew97/herbivore.git",
		"directory": "mobile"
	}
}
