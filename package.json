{
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/MutliDrew97/herbivore"
	},
	"scripts": {
		"build": "npm run build",
		"clean": "npm run clean",
		"rebuild": "npm run rebuild",
		"publish": "npm run publish:prod",
		"publish:dry": "npm run publish:dry",
