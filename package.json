{
	"workspaces": [
		"./core",
		"./api",
		"./log"
	],
	"private": true,
	"scripts": {
		"build": "npm run build --workspaces",
		"clean": "npm run clean --workspaces",
		"rebuild": "npm run rebuild --workspaces",
		"publish": "npm run publish:prod --workspaces",
		"publish:dry": "npm run publish:dry --workspaces",
		"test": "npm run test --workspaces",
		"upgrade": "npm run upgrade:mono && npm run upgrade --workspaces",
		"upgrade:mono": "npm update --save && npm update --save-dev"
	},
	"peerDependencies": {
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.20",
		"@types/node": "^24.9.2",
		"lodash": "^4.17.21",
		"ts-jest": "^29.4.5",
		"ts-node": "^10.9.2"
	}
}
