{
	"private": true,
	"scripts": {
		"build": "npm run build --workspaces",
		"clean": "npm run clean --workspaces",
		"rebuild": "npm run rebuild --workspaces",
		"publish": "npm run publish:prod --workspaces",
		"publish:dry": "npm run publish:dry --workspaces",
		"test": "vitest",
		"update": "npm run update:mono && npm run update --workspaces",
		"update:mono": "npm update --save && npm update --save-dev"
	},
	"workspaces": [
		"core",
		"log",
		"api",
		"mobile"
	],
	"devDependencies": {
		"@types/lodash": "^4.17.21",
		"@types/node": "^24.12.0",
		"lodash": "^4.17.23",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.16",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.0"
	}
}
