{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Test All Packages",
			"detail": "Test all subpackages within the monorepo",
			"type": "npm",
			"script": "test",
			"group": "test",
			"problemMatcher": [],
			"icon": { "id": "beaker" },
			"options": { "cwd": "${workspaceFolder}" },
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"clear": true,
				"showReuseMessage": false
			}
		},
		{
			"label": "Test Specific Package",
			"detail": "Test a certain subpackage within the monorepo",
			"type": "shell",
			"command": "npm",
			"options": { "cwd": "${workspaceFolder}" },
			"icon": { "id": "beaker" },
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"clear": true,
				"showReuseMessage": false
			},
			"args": ["test", "--", "--selectProjects", "${input:project}"],
			"group": "test",
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "project",
			"type": "pickString",
			"options": ["LOG", "CORE", "API"],
			"description": "Which Project"
		}
	]
}
