{
	"version": "2.0.0",
	"options": {
		"cwd": "${workspaceFolder}"
	},
	"tasks": [
		{
			"label": "Test All Packages",
			"detail": "Test all subpackages within the monorepo",
			"type": "shell",
			"command": "npm",
			"args": ["test"],
			"group": "test",
			"problemMatcher": [],
			"icon": {
				"id": "beaker"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"clear": true,
				"showReuseMessage": false
			}
		},
		{
			"label": "Test Specific Package",
			"detail": "Test a certain subpackage within the monorepo",
			"group": "test",
			"type": "shell",
			"command": "npm",
			"args": ["test", "--", "--project", "${input:project}"],
			"icon": {
				"id": "beaker"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"clear": true,
				"showReuseMessage": false
			},
			"problemMatcher": []
		},
		{
			"label": "Build All Packages",
			"detail": "Build all subpackages within the monorepo",
			"group": "build",
			"type": "shell",
			"command": "npm",
			"args": ["run", "build", "--", "--workspaces"],
			"problemMatcher": [],
			"icon": {
				"id": "build"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"clear": true,
				"showReuseMessage": false
			}
		},
		{
			"label": "Build Specific Package",
			"detail": "Build a certain subpackage within the monorepo",
			"group": "build",
			"type": "shell",
			"command": "npm",
			"icon": {
				"id": "build"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"clear": true,
				"showReuseMessage": false
			},
			"args": ["run", "build", "--", "-w", "${input:project}"],
			"problemMatcher": []
		},
		{
			"label": "Rebuild All Packages",
			"detail": "Rebuild all subpackages within the monorepo",
			"group": "build",
			"type": "shell",
			"command": "npm",
			"args": ["run", "rebuild", "--", "--workspaces"],
			"problemMatcher": [],
			"icon": {
				"id": "build"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"clear": true,
				"showReuseMessage": false
			}
		},
		{
			"label": "Rebuild Specific Package",
			"detail": "Rebuild a certain subpackage within the monorepo",
			"group": "build",
			"type": "shell",
			"command": "npm",
			"icon": {
				"id": "build"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"clear": true,
				"showReuseMessage": false
			},
			"args": ["run", "rebuild", "--", "-w", "${input:project}"],
			"problemMatcher": []
		},
		{
			"label": "Clean All Packages",
			"detail": "Clean all subpackages within the monorepo",
			"type": "shell",
			"command": "npm",
			"args": ["run", "clean", "--", "--workspaces"],
			"problemMatcher": [],
			"icon": {
				"id": "clear-all"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"clear": true,
				"showReuseMessage": false
			}
		},
		{
			"label": "Clean Specific Package",
			"detail": "Clean a certain subpackage within the monorepo",
			"type": "shell",
			"command": "npm",
			"icon": {
				"id": "clear-all"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"clear": true,
				"showReuseMessage": false
			},
			"args": ["run", "clean", "--", "-w", "${input:project}"],
			"problemMatcher": []
		},
		{
			"label": "Publish All (Dry)",
			"detail": "Run the dry run publish for all packages in the workspace",
			"type": "npm",
			"script": "publish:dry",
			"icon": {
				"id": "broadcast"
			},
			"problemMatcher": []
		},
		{
			"label": "Publish All (Prod)",
			"detail": "Run the publish for all packages in the workspace",
			"type": "shell",
			"command": "npm",
			"args": ["run", "publish:prod", "--", "--workspaces"],
			"problemMatcher": []
		},
		{
			"label": "Publish Specific Package (Dry)",
			"detail": "Run the dry run publish for a specific packages in the workspace",
			"type": "shell",
			"command": "npm",
			"args": ["run", "publish:dry", "--", "-w", "${input:project}"],
			"icon": {
				"id": "broadcast"
			},
			"problemMatcher": []
		},
		{
			"label": "Publish Specific Package (Prod)",
			"detail": "Run the publish for a specific package in the workspace",
			"type": "shell",
			"command": "npm",
			"args": ["run", "publish", "--", "-w", "${input:project}"],
			"icon": {
				"id": "broadcast"
			},
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "project",
			"type": "pickString",
			"options": ["log", "core", "api", "mobile"],
			"description": "Which Project?"
		}
	]
}
