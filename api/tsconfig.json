{
	"extends": "../tsconfig.base.json",
	"include": ["src"],
	"exclude": ["node_modules", "lib", "spec"],
	"compilerOptions": {
		"composite": true,
		"outDir": "./lib",
		"rootDir": "./src",
		"tsBuildInfoFile": "./lib/tsconfig.tsbuildinfo",
		"paths": {
			"@src": ["./src/index.ts"],
			"@src/*": ["./src/*.ts"]
		}
	}
}
