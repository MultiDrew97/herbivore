{
	"name": "@herbivore/api",
	"version": "2.0.0",
	"description": "Herbivore Project API Tools",
	"author": "Herbivore",
	"license": "MIT",
	"main": "./lib/index.js",
	"typings": "./lib/index.d.ts",
	"files": [
		"src",
		"lib"
	],
	"scripts": {
		"build": "tsc",
		"build:test": "tsc -p ./spec/tsconfig.spec.json",
		"test": "jest --config=./spec/jest.config.ts",
		"publish:prod": "npm publish --access public",
		"publish:dry": "npm publish --access public --dry-run",
		"upgrade": "npm upgrade --save"
	},
	"engines": {
		"node": "^14.15.0 || >=16.10.0"
	},
	"dependencies": {
		"@herbivore/core": "^3.1.1",
		"js-base64": "^3.7.7",
		"mongoose": "^8.9.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@skypack/package-check": "^0.2.2",
		"@types/jest": "^29.5.14",
		"@types/node": "^18.19.68",
		"jasmine-spec-reporter": "^7.0.0",
		"jest": "^29.7.0",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"typescript": "^4.9.5"
	},
	"keywords": [
		"api",
		"herbivore"
	],
	"repository": {
		"url": "https://github.com/MultiDrew97/hpm-modules",
		"directory": "api",
		"type": "git"
	},
	"directories": {
		"test": "./spec",
		"lib": "./dist"
	}
}
