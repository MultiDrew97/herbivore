{
	"name": "@herbivore/api",
	"version": "0.3.0",
	"author": "Herbivore",
	"description": "Herbivore Project Package - API",
	"license": "MIT",
	"scripts": {
		"build": "tsc && tsc-alias",
		"clean": "rm -rf lib tsconfig.tsbuildinfo",
		"rebuild": "npm run clean && npm run build",
		"test": "vitest",
		"prepublishOnly": "npm test && npm run rebuild",
		"publish:prod": "npm publish --access public",
		"publish:dry": "npm publish --access public --dry-run",
		"upgrade": "npm update --save && npm update --save-dev"
	},
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./*": {
			"types": "./lib/*.d.ts",
			"default": "./lib/*.js"
		},
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"express": "^5.1.0"
	},
	"dependencies": {
		"@herbivore/core": "^4.1.2",
		"helmet": "^8.1.0",
		"reflect-metadata": "^0.2.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@types/express": "^5.0.5",
		"@types/lodash": "^4.17.21",
		"axios": "^1.13.2",
		"lodash": "^4.17.23",
		"typescript": "^5.9.3"
	},
	"files": [
		"./lib",
		"./src"
	],
	"directories": {
		"lib": "./lib",
		"test": "./spec"
	},
	"keywords": [
		"api",
		"herbivore",
		"node",
		"express",
		"ts"
	],
	"repository": {
		"url": "https://github.com/MultiDrew97/herbivore",
		"directory": "api",
		"type": "git"
	}
}
