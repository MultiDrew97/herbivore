{
	"name": "@herbivore/logger",
	"version": "2.0.0",
	"description": "Herbivore Project Pacakge - Log",
	"author": "Herbivore",
	"license": "MIT",
	"main": "./lib/index.js",
	"typings": "./lib/index.d.ts",
	"files": [
		"src",
		"lib"
	],
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf lib",
		"rebuild": "npm run clean && npm run build",
		"build:test": "tsc -p ./tsconfig.spec.json",
		"test": "jest --config=./spec/jest.config.ts",
		"publish:prod": "npm publish --access public",
		"publish:dry": "npm publish --access public --dry-run",
		"upgrade": "npm update --save && npm update --save-dev"
	},
	"dependencies": {
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@skypack/package-check": "^0.2.2",
		"@types/jest": "^29.5.14",
		"@types/lodash": "^4.17.16",
		"@types/node": "^18.19.86",
		"jest": "^29.7.0",
		"lodash": "^4.17.21",
		"ts-jest": "^29.3.2",
		"ts-node": "^10.9.2",
		"typescript": "5.8.3"
	},
	"keywords": [
		"log",
		"herbivore"
	],
	"repository": {
		"url": "https://github.com/MultiDrew97/herbivore",
		"directory": "log",
		"type": "git"
	},
	"directories": {
		"lib": "./lib"
	}
