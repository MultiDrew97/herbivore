{
	"name": "@herbivore/logger",
	"version": "1.0.0",
	"description": "A module to try to help simplify and add scalability to my personal projects.",
	"author": "Herbivore",
	"license": "MIT",
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc",
		"build:test": "tsc -p ./spec/tsconfig.spec.json",
		"test": "jest --config=./spec/jest.config.ts",
		"publish:prod": "cp package.json ./dist && cd dist && npm publish --access public",
		"publish:dry": "cp package.json ./dist && cd dist && npm publish --access public --dry-run",
		"upgrade": "npm update --save"
	},
	"engines": {
		"node": "^14.15.0 || >=16.10.0"
	},
	"dependencies": {
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@skypack/package-check": "^0.2.2",
		"@types/jest": "^29.5.14",
		"@types/lodash": "^4.17.13",
		"@types/node": "^18.19.68",
		"jest": "^29.7.0",
		"lodash": "^4.17.21",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"typescript": "^4.9.5"
	},
	"exports": {
		".": "./index.js",
		"./package.json": "./package.json"
	},
	"keywords": [
		"log",
		"hpm"
	]
}
